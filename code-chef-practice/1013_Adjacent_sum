// Chef has an array A of length N.Chef forms a binary arrayB of length N using the parity of the sums of adjacent elements in A. Formally Bi=( Ai + A(i+1) ) %2  for 1≤i≤N−1
// Bi =(Ai + A(i+1))%2  
// Here x%y denotes the remainder obtained when x is divided by y.

// Chef lost the array A and needs your help. Given array B, determine whether there exists any valid array \
// A which could have formed B




#include <stdio.h>
#include <stdbool.h>

int main() {
    int t;
    scanf("%d", &t);

    while (t--) {
        int n;
        scanf("%d", &n);

        int b[n];
        for (int i = 0; i < n; i++) {
            scanf("%d", &b[i]);
        }

        // Check if a valid array A exists
        bool possible = false;
        for (int first_element = 0; first_element <= 1; first_element++) {
            int a[n];
            a[0] = first_element;
            bool valid = true;

            // Construct array A based on array B and the first element
            for (int i = 1; i < n; i++) {
                a[i] = (b[i - 1] - a[i - 1] % 2 + 2) % 2;  // Ensure a[i] is 0 or 1
            }

            // Check the last element
            if ((a[n - 1] + a[0]) % 2 == b[n - 1]) {
                possible = true;
                break;
            }
        }

        if (possible) {
            printf("YES\n");
        } else {
            printf("NO\n");
        }
    }

    return 0;
}